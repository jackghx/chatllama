# ---- Ollama ----
OLLAMA_HOST=http://192.168.0.100:11434
OLLAMA_TIMEOUT_MS=120000

# Reasoning models are slow and their reasoning is thrown away here, so false is
# usually what you want. Leave it empty for models that cannot think at all,
# which older Ollama builds reject the field on. Check with: ollama show <model>
OLLAMA_THINK=

# How long Ollama keeps the model in memory after answering. Empty uses its own
# default of five minutes, which is no longer than the silence a briefing waits
# for, so on the defaults a briefing can still load the model off disk
# first. 30m, or -1 to keep it loaded for good. Only affects the model this bot
# asks for, not everything else on that machine.
#
# Worth setting to 30m. In auto mode the model is idle nearly all day, because
# the fixed reply never touches it, so it has almost always been evicted by the
# time somebody uses the prefix and they wait for it to come off disk.
OLLAMA_KEEP_ALIVE=

# Loads the model, and reads the persona into its cache, when somebody starts a
# conversation rather than when they finally ask something.
#
# The second half is the one that matters. On a CPU, reading the prompt costs
# more than loading the weights and far more than writing the reply: measured on
# an 8B, a 480-token persona took 82 seconds to read against 12 to load and 16
# to answer. Ollama keeps the evaluated prompt, so the same persona arriving
# again costs about 4 seconds, and every reply opens with it.
#
# Writes one token, so it cannot say anything, and is throttled to once a minute
# however many people are writing in. Turn it off if the machine running Ollama
# is shared and you would rather it only held the model when it is really in use.
OLLAMA_WARMUP=true

# ---- Replies ----
# always | prefix | auto | off
#   always  the model answers everything
#   prefix  the model answers the command, everything else is ignored
#   auto    a fixed reply to everything, the model only on the command
#   off     nothing is answered at all
# auto is the default. Set always for the behaviour before 3.0.0.
REPLY_MODE=auto
COMMAND_PREFIX=/ai

# The fixed reply in auto mode. No model in the path, so it goes out instantly
# and can never say anything that is not written here.
#
# Three states, and the difference between the last two catches people out:
#   commented out  the default wording, which tells people about COMMAND_PREFIX
#   AUTO_REPLY_TEXT=your words here
#   AUTO_REPLY_TEXT=       sends nothing, which makes auto mode behave as prefix
#
# It is left commented here so that copying this file gives a bot that answers.
# AUTO_REPLY_TEXT=

# Measured from when they last wrote, not from when the fixed reply last went
# out, so a burst of messages gets one reply and somebody coming back tomorrow
# gets another. A plain cooldown would fire again mid-conversation.
AUTO_REPLY_GAP_MINUTES=60

# The daily cap on top of that, so somebody messaging just outside the gap all
# day is not texted every hour. 0 removes it.
AUTO_REPLY_MAX_PER_DAY=3

# How long a conversation keeps reaching the model after somebody has used the
# prefix once. Nobody types it on every message, so without this the follow-up
# to a real answer gets the canned line and has to be sent again. Measured from
# their last answer, per conversation. 0 requires the prefix every time.
FOLLOW_UP_MINUTES=15

# ---- Steering it from your own phone ----
# off | self | any
# Type "/ai status", "/ai off", "/ai on", "/ai away 2h in a meeting" or
# "/ai back" and the bot obeys. Mode and away survive a restart, kept in
# STATE_FILE below, because "/ai away 1w" is a promise to everyone who writes in
# and pm2 restarting overnight is not you cancelling it. Note that a command
# typed into a friend's chat
# is a message you have just sent that friend, and they can read it, which is
# why self (your own Note to Self chat) is the default. Never works in a group.
OWNER_COMMANDS=self

# Whether the bot replies to confirm it understood.
OWNER_COMMAND_ACK=true

# ---- Access ----
# Phone numbers, with the country code and no punctuation or plus sign. They
# are resolved to WhatsApp's own identifiers at startup. Empty allows anyone.
#
# Before 3.0.0 this held @lid values. Those still work if you leave them, and
# an entry containing an @ is always taken as written and never looked up.
#
# Empty here on purpose. Filling it in with the example numbers below would
# leave a fresh copy of this file ignoring every real person who wrote in.
#   ALLOWED_CONTACTS=447700900123,447700900456
ALLOWED_CONTACTS=

# Where the resolved identifiers are kept, so a restart costs no lookups. The
# directory is gitignored. Delete the file to force a fresh resolution.
CONTACT_CACHE_FILE=.cache/identity.json
CONTACT_CACHE_TTL_DAYS=30

# Where "away" and the mode set by command are kept between runs.
#
# "/ai away 1w" is a promise to everyone who writes in, and pm2 restarting at
# four in the morning is not you cancelling it. What is stored is the moment the
# away ends rather than what is left of it, so time spent down still counts:
# away for a week, restarted on day three, still away until day seven.
#
# Set it empty to turn this off and go back to starting from REPLY_MODE every
# time. Delete the file to clear whatever is in force.
STATE_FILE=.cache/state.json

# Where settings changed by command are kept, which is a layer on top of this
# file rather than a replacement for it: nothing is stored until it is changed,
# an untouched setting reads straight through to here, and "/ai reset <name>"
# puts it back. That ordering is what stops it becoming a second, silent copy of
# the configuration that nobody remembers is there.
#
# Send "/ai settings" to see everything, "/ai set gap 90" to change one, and
# "/ai reset all" to go back to this file entirely.
SETTINGS_FILE=.cache/settings.json

# The lookups are rate limited by WhatsApp, so they are spaced out.
CONTACT_RESOLVE_DELAY_MS=500

# Logs the ID of everyone who writes in, and whether it matched the allowlist,
# while answering nobody. A diagnostic for "why is this person being ignored",
# now that the numbers above resolve themselves.
CAPTURE_IDS=false

# Drops the backlog whatsapp-web.js replays on connect.
IGNORE_OLDER_THAN_SECONDS=30

ALLOW_GROUPS=false

# 0 disables.
MAX_REPLIES_PER_HOUR=20

# Sent once when someone hits the cap, so the silence that follows is explained.
# Delete the text to send nothing. Comment the line out for the default wording.
RATE_LIMIT_NOTICE=That is as many automatic replies as this number sends in an hour. Your messages are still coming through and will be read.

# Added when somebody sends an attachment with no caption: a voice note, a
# photo, a document. Nothing here can read any of those, and saying so is better
# than the silence they used to get, which reads as the number being dead. The
# attachment still reaches your briefing either way. {what} becomes "voice
# notes", "images" and so on. Delete the text to send nothing extra.
MEDIA_NOTICE=Unable to process {what}. Please send text only.

# How long the bot keeps out of a conversation after you have answered that
# person yourself, whether typed on your phone or approved from a briefing.
#
# Somebody who has just replied is demonstrably at their phone, so the fixed
# reply saying nobody is watching this number would be a lie with the evidence
# directly above it. It matters more for an approved draft: that goes out
# unmarked, as you, so the other person believes they are talking to a human and
# would then be answered by the model underneath you. An explicit /ai still
# reaches the model throughout. 0 turns it off.
HANDOVER_MINUTES=30

# Whether what you send by hand is kept in that conversation's transcript, which
# is held in memory only and never written anywhere. On, the model and the
# briefing know what has already been said. Off, they do not, and a briefing
# will happily draft a reply to a question you answered ten minutes ago.
RECORD_OWN_REPLIES=true

# Hours to behave as though away, so it does not have to be remembered every
# evening. Two 24-hour times, and it may run past midnight. Local time, because
# whoever sets it is thinking in their own hours. Empty is off.
#   QUIET_HOURS=22:00-08:00
QUIET_HOURS=

# auto sends the fixed reply through the night, off answers nothing at all.
# Neither can make a bot you switched off start answering again.
QUIET_HOURS_MODE=auto

# Someone who corrects themselves mid-reply gets one answer to both messages.
# This caps how many times a reply is scrapped and written again. 0 answers
# every message separately, which is what it did before.
MAX_INTERRUPTS=3

# How long a conversation has to be quiet before a reply is started at all.
#
# People send a question in two or three parts. Starting on the first part means
# the work is thrown away when the second arrives, and with MAX_INTERRUPTS at 3
# one reply can cost four full generations. Waiting a couple of seconds absorbs
# the burst before anything has been spent on it, and messages arriving inside
# the wait do not count against MAX_INTERRUPTS because nothing was discarded.
#
# Measured from their last message, so a question sent in one go waits this once
# and no longer. The wait itself is capped at three times this value, so someone
# typing steadily cannot defer their own answer indefinitely. 0 starts at once.
REPLY_DEBOUNCE_MS=2000

# Shows "typing..." while a reply is being written. It makes nothing faster. A
# minute of silence reads as a number that has stopped working, and the same
# minute with this on reads as somebody composing a message.
TYPING_INDICATOR=true

# ---- Assistant ----
ASSISTANT_MODEL=llama3.1:8b
ASSISTANT_MEMORY_WINDOW=20

# A ceiling on the reply, not a target.
#
# It changes nothing about how the model writes: same prompt, same sampling,
# same first hundred tokens. All it does is refuse to let a reply run on, and
# the wait tracks the number of tokens produced, so the only replies it costs
# anything are the ones that had already gone wrong. Well above what any of the
# bundled personas need, since they all ask for two short lines.
#
# A reply that does reach the ceiling is cut back to its last finished sentence
# rather than sent half written, and the log says so. Raise it if that keeps
# happening with a persona of your own. 0 removes the limit.
#
# The briefing has no ceiling. Nobody is waiting on one, and cutting a JSON
# document short leaves it unparseable, which would lose the briefing entirely.
ASSISTANT_MAX_TOKENS=400

# First one set wins, otherwise prompts/assistant.md.
SYSTEM_PROMPT_FILE=
SYSTEM_PROMPT=

# always | first | never
AI_PREFIX=[AI]
AI_PREFIX_MODE=always

# ---- n8n ----
# Empty disables. The path is whatever you set on the Webhook node. Use the
# /webhook-test/ form while building, which only listens while the n8n editor
# is open, then switch to /webhook/ and activate the workflow.
# https://n8n.example.com/webhook/chatllama
N8N_WEBHOOK_URL=
WEBHOOK_IN_SIM=false

# ---- Send endpoint ----
# Lets n8n hand a message back for the bot to send, which is what turns a
# drafted reply into one you approve with a tap rather than retype.
#
# Empty disables it, and the port is the only switch. It will not start without
# a key: an endpoint reachable on a LAN with no credential is a spam relay
# wired to your real phone number. Never put this behind a port forward.
#
# Generate a key and store its digest, not the key itself:
#   KEY=$(openssl rand -hex 32); echo "$KEY"; printf %s "$KEY" | sha512sum
SEND_API_PORT=
SEND_API_HOST=127.0.0.1
SEND_API_KEY_SHA512=

# A ceiling for the endpoint as a whole, separate from MAX_REPLIES_PER_HOUR so
# that a reply you approved is never refused because that chat was busy.
SEND_API_MAX_PER_MINUTE=30

# Off means it can only message people named in ALLOWED_CONTACTS, so a leaked
# key cannot message anybody at all from your number. An empty ALLOWED_CONTACTS
# means anyone may write in, never that anyone may be written to, so with both
# of these off the endpoint refuses every recipient and says so at startup.
SEND_API_ALLOW_ANY=false

# ---- Discord status light ----
# A single message in a Discord channel, edited in place, that goes green when
# this is answering and red when it is not. A Discord webhook can edit messages
# it sent itself with no bot token and nothing listening on this side, which
# makes this the cheapest honest status light available.
#
# Pin the message by hand once after it first appears: a webhook cannot pin its
# own. Empty turns this off. See docs/discord-control.md.
DISCORD_STATUS_WEBHOOK=
DISCORD_STATUS_SECONDS=60
DISCORD_STATUS_FILE=.cache/discord-status.json

# ---- Summaries ----
# One conversation_summary event after this much silence. 0 disables.
SUMMARY_IDLE_MINUTES=5

# Summarise anyway once a conversation reaches this many exchanges.
SUMMARY_MAX_MESSAGES=15

# json | prose
# json asks for fields n8n can branch on: how urgent it is, what they wanted, any
# deadline, and a reply you could send back. prose is the old free-text briefing,
# for a model too small to hold a schema. Either way the summary field stays a
# sentence, so an existing workflow keeps working.
SUMMARY_FORMAT=json

# The briefing runs after the reply has gone out, so nobody is waiting on it and
# it can afford a slower model than the one answering. Empty uses ASSISTANT_MODEL.
SUMMARY_MODEL=

# The briefing's own budget, separate from OLLAMA_TIMEOUT_MS because that one
# governs somebody staring at their phone. This job is the slower of the two: a
# schema constrains every token, and after several idle minutes Ollama has
# usually unloaded the model, so the first call pays to load it again.
SUMMARY_TIMEOUT_MS=300000
