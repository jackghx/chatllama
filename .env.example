# ---- Ollama ----
# Base URL of your Ollama instance. Use the /api endpoints, not /v1.
OLLAMA_HOST=http://192.168.0.100:11434
OLLAMA_TIMEOUT_MS=120000

# ---- Reply mode ----
# always: reply to every message that passes the filters below. This is the
#         point of the project.
# prefix: only reply to messages starting with COMMAND_PREFIX. Quieter, and
#         useful while you are still tuning the system prompt.
REPLY_MODE=always

# Used in prefix mode only, ignored in always mode.
COMMAND_PREFIX=/ai

# ---- Access control ----
# Comma separated list of WhatsApp IDs allowed to use the bot.
# Newer whatsapp-web.js versions report contacts as <id>@lid rather than
# <number>@c.us. Run with LOG_UNMATCHED=true to discover the correct value,
# then paste it here.
#
# Leaving this empty in always mode means everyone who messages the account
# gets an automated reply, including people not in your contacts. Set it.
ALLOWED_CONTACTS=

# Log the sender ID of messages that do not match ALLOWED_CONTACTS.
# Useful once, when first setting up. Turn off afterwards.
LOG_UNMATCHED=false

# Messages older than this are ignored on startup, so the bot does not
# reply to the backlog whatsapp-web.js replays when it connects.
IGNORE_OLDER_THAN_SECONDS=30

# Reply in group chats. Off by default: in always mode this answers every
# member's every message.
ALLOW_GROUPS=false

# Per conversation cap over a rolling hour. Stops two auto repliers pointed at
# each other from running forever. Zero or less disables the limit.
MAX_REPLIES_PER_HOUR=20

# ---- Assistant ----
ASSISTANT_MODEL=llama3.1:8b
ASSISTANT_MEMORY_WINDOW=20

# Where the persona comes from, tried in this order:
#   1. SYSTEM_PROMPT_FILE   path to a text or markdown file
#   2. SYSTEM_PROMPT        inline string
#   3. prompts/assistant.md the bundled default
# Whichever wins is logged at startup. Point SYSTEM_PROMPT_FILE at your own
# copy so a git pull cannot overwrite your wording.
SYSTEM_PROMPT_FILE=
SYSTEM_PROMPT=

# ---- Self-disclosure notice ----
# Attached in code, not asked of the model, because a model told to always emit
# a fixed string eventually will not.
#
# always: on every reply
# first:  once per conversation, then not again
# never:  off, nothing marks the replies as automated
AI_PREFIX=[AI]
AI_PREFIX_MODE=always

# ---- n8n ----
# Optional. Leave empty to disable webhook logging entirely.
# Use the /webhook-test/ URL while building the workflow, /webhook/ once live.
N8N_WEBHOOK_URL=

# Fire the webhook during --sim runs too. Handy while testing the n8n side.
WEBHOOK_IN_SIM=false
