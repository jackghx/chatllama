# ---- Ollama ----
OLLAMA_HOST=http://192.168.0.100:11434
OLLAMA_TIMEOUT_MS=120000

# ---- Replies ----
# always | prefix
REPLY_MODE=always
COMMAND_PREFIX=/ai

# ---- Access ----
# Looks like 183765432109876@lid, not the phone number. Empty allows anyone.
ALLOWED_CONTACTS=

# Logs the ID of everyone who writes in and answers none of them, which is how
# the line above gets filled in. Turn it off afterwards.
CAPTURE_IDS=false

# Drops the backlog whatsapp-web.js replays on connect.
IGNORE_OLDER_THAN_SECONDS=30

ALLOW_GROUPS=false

# 0 disables.
MAX_REPLIES_PER_HOUR=20

# ---- Assistant ----
ASSISTANT_MODEL=llama3.1:8b
ASSISTANT_MEMORY_WINDOW=20

# First one set wins, otherwise prompts/assistant.md.
SYSTEM_PROMPT_FILE=
SYSTEM_PROMPT=

# always | first | never
AI_PREFIX=[AI]
AI_PREFIX_MODE=always

# ---- n8n ----
# Empty disables. Use the /webhook-test/ URL while building the workflow.
N8N_WEBHOOK_URL=
WEBHOOK_IN_SIM=false

# ---- Summaries ----
# One conversation_summary event after this much silence. 0 disables.
SUMMARY_IDLE_MINUTES=10

# Summarise anyway once a conversation reaches this many exchanges.
SUMMARY_MAX_MESSAGES=15
